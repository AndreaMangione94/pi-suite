{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "connections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "providerType": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "protocol": {
            "enum": [
              "openai-completions",
              "openai-responses",
              "anthropic-messages",
              "google-generative-ai"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "secret",
                  "env",
                  "none"
                ]
              },
              "ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_/-]{1,200}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "header": {
                "enum": [
                  "Authorization",
                  "authorization",
                  "api-key",
                  "x-api-key",
                  "x-goog-api-key"
                ]
              },
              "prefix": {
                "enum": [
                  "",
                  "Bearer "
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "secret"
                    }
                  }
                },
                "then": {
                  "required": [
                    "ref"
                  ],
                  "not": {
                    "required": [
                      "name"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "env"
                    }
                  }
                },
                "then": {
                  "required": [
                    "name"
                  ],
                  "not": {
                    "required": [
                      "ref"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "none"
                    }
                  }
                },
                "then": {
                  "maxProperties": 1
                }
              }
            ]
          },
          "models": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "contextWindow": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 100000000
                    },
                    "maxOutputTokens": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000000
                    }
                  },
                  "required": [
                    "contextWindow",
                    "maxOutputTokens"
                  ],
                  "additionalProperties": false
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "toolCalling": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "vision": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "streaming": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "reasoning": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "levels": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "off",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh"
                        ]
                      },
                      "uniqueItems": true
                    },
                    "defaultEffort": {
                      "enum": ["off", "minimal", "low", "medium", "high", "xhigh"]
                    }
                  },
                  "required": [
                    "enabled",
                    "levels"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "limits",
                "capabilities",
                "reasoning"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "providerType",
          "auth",
          "models"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "providerType": {
                  "enum": [
                    "custom",
                    "lmstudio",
                    "ollama"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "protocol",
                "baseUrl"
              ]
            }
          }
        ]
      }
    },
    "profiles": {
      "type": "object",
      "properties": {
        "orchestrator": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "effort": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "connectionId",
            "modelId",
            "effort"
          ],
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "effort": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "connectionId",
            "modelId",
            "effort"
          ],
          "additionalProperties": false
        },
        "research": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "effort": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "connectionId",
            "modelId",
            "effort"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "effort": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "connectionId",
            "modelId",
            "effort"
          ],
          "additionalProperties": false
        },
        "documentation": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "effort": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "connectionId",
            "modelId",
            "effort"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "connections"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi-suite:byok:1",
  "title": "Pi Suite BYOK schema 1",
  "description": "Ulteriori vincoli semantici (ID univoci, URL locali/HTTPS, limiti e profili) verificati dal backend."
}
