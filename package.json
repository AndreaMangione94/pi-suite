{
  "name": "pi-suite",
  "version": "0.6.5",
  "private": true,
  "description": "Pi Suite: chat orchestratore, incarichi Markdown ai subagenti e grafo locale",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./suite-extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "format": "prettier --write . && python -m ruff format .",
    "format:check": "prettier --check . && python -m ruff format --check ."
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "pi-subagents": "0.79.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "prettier": "3.6.2"
  },
  "license": "MIT"
}
